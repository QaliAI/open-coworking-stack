{
  "$ref": "#/definitions/Workflow",
  "definitions": {
    "Workflow": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "enum": [
            "member-onboarding",
            "member-offboarding",
            "day-pass-checkin",
            "tour-to-close",
            "room-booking",
            "desk-hot-desk",
            "invoice-collections",
            "access-provisioning",
            "visitor-management",
            "event-lifecycle",
            "mail-package-handling",
            "community-programming",
            "incident-response",
            "facility-maintenance",
            "marketing-campaigns",
            "reporting-kpis",
            "multi-site-rollout",
            "backup-restore-drill",
            "vendor-offboarding",
            "compliance-review"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "primary_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "owner-operator",
              "community-manager",
              "sales-manager",
              "operations-manager",
              "marketing",
              "virtual-office-mailroom",
              "event-coordinator",
              "multi-location-operator",
              "franchisee",
              "consultant-implementer",
              "technical-operator",
              "finance",
              "facilities",
              "member-end-user"
            ]
          },
          "minItems": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "manual_tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "automation_opportunities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "suggested_tool_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["id", "name", "description"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "success_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "verification": {
          "type": "object",
          "properties": {
            "last_reviewed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": ["last_reviewed"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "description",
        "primary_roles",
        "stages",
        "success_metrics",
        "verification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
