{
  "$ref": "#/definitions/Workflow",
  "definitions": {
    "Workflow": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "primary_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "owner-operator",
              "community-manager",
              "sales-manager",
              "operations-manager",
              "marketing",
              "virtual-office-mailroom",
              "event-coordinator",
              "multi-location-operator",
              "franchisee",
              "consultant-implementer",
              "technical-operator",
              "finance",
              "facilities",
              "member-end-user"
            ]
          },
          "minItems": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "manual_tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "automation_opportunities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "suggested_tool_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["id", "name", "description"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "success_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "objective": {
          "type": "string",
          "default": "Not yet documented."
        },
        "responsible_role": {
          "type": "string",
          "default": "Not yet documented."
        },
        "trigger": {
          "type": "string",
          "default": "Not yet documented."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_of_truth": {
          "type": "string",
          "default": "Not yet documented."
        },
        "systems_involved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "automation_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "human_approval_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "failure_exception_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "privacy_risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "security_risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "measurable_kpis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "test_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "manual_fallback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "rollback_disable_procedure": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "verification": {
          "type": "object",
          "properties": {
            "last_reviewed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": ["last_reviewed"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "description",
        "primary_roles",
        "stages",
        "success_metrics",
        "verification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
