{
  "$ref": "#/definitions/Stack",
  "definitions": {
    "Stack": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "audience_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "owner-operator",
              "community-manager",
              "sales-manager",
              "operations-manager",
              "marketing",
              "virtual-office-mailroom",
              "event-coordinator",
              "multi-location-operator",
              "franchisee",
              "consultant-implementer",
              "technical-operator",
              "finance",
              "facilities",
              "member-end-user"
            ]
          },
          "minItems": 1
        },
        "problems_solved": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "reduce-software-cost",
              "replace-spreadsheets",
              "self-host-for-data-control",
              "improve-member-experience",
              "automate-billing",
              "secure-door-access",
              "fill-meeting-rooms",
              "grow-pipeline",
              "run-events",
              "operate-virtual-office",
              "multi-location-consistency",
              "reduce-manual-admin",
              "improve-wifi-reliability",
              "centralize-knowledge",
              "measure-utilization",
              "privacy-compliance",
              "disaster-recovery",
              "integrate-stack"
            ]
          },
          "minItems": 1
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "member-onboarding",
              "member-offboarding",
              "day-pass-checkin",
              "tour-to-close",
              "room-booking",
              "desk-hot-desk",
              "invoice-collections",
              "access-provisioning",
              "visitor-management",
              "event-lifecycle",
              "mail-package-handling",
              "community-programming",
              "incident-response",
              "facility-maintenance",
              "marketing-campaigns",
              "reporting-kpis",
              "multi-site-rollout",
              "backup-restore-drill",
              "vendor-offboarding",
              "compliance-review"
            ]
          },
          "minItems": 1
        },
        "monthly_cash_budget_band": {
          "type": "string",
          "enum": ["near-zero", "under-50", "under-200", "under-500", "flexible"]
        },
        "self_host_heavy": {
          "type": "boolean",
          "default": false
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool_id": {
                "type": "string",
                "minLength": 1
              },
              "role_in_stack": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean",
                "default": true
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["tool_id", "role_in_stack"],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "getting_started": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "verification": {
          "type": "object",
          "properties": {
            "last_reviewed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": ["last_reviewed"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "tagline",
        "description",
        "audience_roles",
        "problems_solved",
        "workflows",
        "monthly_cash_budget_band",
        "components",
        "assumptions",
        "risks",
        "getting_started",
        "verification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
