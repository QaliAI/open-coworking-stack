async function main() {
  const toolsDir = path.join(root, 'catalog', 'tools');
  const stacksDir = path.join(root, 'catalog', 'stacks');
  const workflowsDir = path.join(root, 'catalog', 'workflows');
  await mkdir(toolsDir, { recursive: true });
  await mkdir(stacksDir, { recursive: true });
  await mkdir(workflowsDir, { recursive: true });

  // Deduplicate by id
  const seen = new Set<string>();
  const unique: SeedTool[] = [];
  for (const tool of allTools) {
    if (seen.has(tool.id)) {
      console.warn('Duplicate tool id skipped:', tool.id);
      continue;
    }
    seen.add(tool.id);
    unique.push(tool);
  }

  for (const tool of unique) {
    const doc = toolYaml(tool);
    const out = path.join(toolsDir, `${tool.id}.yaml`);
    await writeFile(out, stringify(doc, { lineWidth: 100, sortMapEntries: false }), 'utf8');
  }

  for (const stack of stacks) {
    await writeFile(
      path.join(stacksDir, `${stack.id}.yaml`),
      stringify(stack, { lineWidth: 100 }),
      'utf8',
    );
  }

  for (const wf of workflows) {
    await writeFile(
      path.join(workflowsDir, `${wf.id}.yaml`),
      stringify(wf, { lineWidth: 100 }),
      'utf8',
    );
  }

  // Template
  await writeFile(
    path.join(toolsDir, '_template.yaml'),
    `# Copy to <slug>.yaml and fill. See packages/schema for full field docs.
schema_version: "1.0.0"
id: your-tool-slug
name: Your Tool
tagline: One-line operator-focused summary
description: >
  At least forty characters describing coworking-relevant use.
categories: [automation-integration]
roles: [technical-operator]
workflows: [member-onboarding]
problems: [reduce-software-cost]
deployment: [self-hosted]
maturity: unknown
license:
  class: unknown-needs-review
  verified_on: "${REVIEWED}"
cost:
  model: unknown
  summary: Describe realistic run cost without inventing prices.
  confidence: unverified
implementation:
  difficulty: moderate
  maintenance_burden: unknown
  skills_required: []
  smallest_useful_experiment: Describe a one-week pilot.
homepage: https://example.com
tasks_reduced_or_augmented:
  - Example repetitive task reduced
human_oversight_still_needed:
  - Example judgment call that remains human
data_privacy:
  data_held: [example]
  personal_data: true
  payment_data: false
risks: {}
integrations: []
related_tools: []
guide_status: stub
guide_path: guides/tools/your-tool-slug.md
tags: []
verification:
  status: unverified
  last_reviewed: "${REVIEWED}"
  sources:
    - https://example.com
  notes: What remains unknown
featured: false
rank_score: 50
`,
    'utf8',
  );

  console.log(
    `Wrote ${unique.length} tools, ${stacks.length} stacks, ${workflows.length} workflows`,
  );
  if (unique.length < 75) {
    console.error(`ERROR: only ${unique.length} tools, need >= 75`);
    process.exitCode = 1;
  }
}

main().catch((e) => {
  console.error(e);
  process.exitCode = 1;
});
