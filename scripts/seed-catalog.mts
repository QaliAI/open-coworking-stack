/**
 * One-shot seeder: writes catalog/tools/*.yaml, stacks, workflows.
 * Safe to re-run; overwrites generated catalog entries.
 */
import { mkdir, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { stringify } from 'yaml';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const REVIEWED = '2026-07-17';

type LicenseClass =
  | 'oss-osi-approved'
  | 'open-core'
  | 'source-available'
  | 'fair-code'
  | 'freemium-saas'
  | 'free-saas'
  | 'free-trial'
  | 'proprietary'
  | 'unknown-needs-review';

interface SeedTool {
  id: string;
  name: string;
  tagline: string;
  description: string;
  categories: string[];
  roles: string[];
  workflows: string[];
  problems: string[];
  deployment: string[];
  maturity?: string;
  license: {
    class: LicenseClass;
    spdx?: string;
    name?: string;
    source_url?: string;
    notes?: string;
  };
  cost: {
    model: string;
    summary: string;
    free_tier_notes?: string;
    self_host_cost_notes?: string;
    pricing_url?: string;
  };
  difficulty: string;
  maintenance?: string;
  skills?: string[];
  ttfv?: string;
  experiment: string;
  homepage: string;
  repository?: string;
  documentation?: string;
  pricing_url?: string;
  tasks: string[];
  oversight: string[];
  data: string[];
  personal?: boolean;
  payment?: boolean;
  privacy_notes?: string;
  risks?: Record<string, string>;
  tags?: string[];
  featured?: boolean;
  rank?: number;
  guide?: 'full' | 'stub';
  compose?: string;
  integrations?: Array<{ name: string; method?: string; verified?: boolean; notes?: string }>;
}

function toolYaml(t: SeedTool): Record<string, unknown> {
  const guide = t.guide ?? (t.featured || (t.rank ?? 50) >= 70 ? 'full' : 'stub');
  return {
    schema_version: '1.0.0',
    id: t.id,
    name: t.name,
    tagline: t.tagline,
    description: t.description,
    status: 'active',
    categories: t.categories,
    secondary_categories: [],
    roles: t.roles,
    workflows: t.workflows,
    problems: t.problems,
    deployment: t.deployment,
    maturity: t.maturity ?? 'stable',
    license: {
      class: t.license.class,
      ...(t.license.spdx ? { spdx: t.license.spdx } : {}),
      ...(t.license.name ? { name: t.license.name } : {}),
      ...(t.license.source_url ? { source_url: t.license.source_url } : {}),
      ...(t.license.notes ? { notes: t.license.notes } : {}),
      verified_on: REVIEWED,
    },
    cost: {
      model: t.cost.model,
      summary: t.cost.summary,
      ...(t.cost.free_tier_notes ? { free_tier_notes: t.cost.free_tier_notes } : {}),
      ...(t.cost.self_host_cost_notes ? { self_host_cost_notes: t.cost.self_host_cost_notes } : {}),
      currency_caveat:
        'Pricing and free-tier limits change frequently; re-check official pricing before budget decisions.',
      ...(t.cost.pricing_url || t.pricing_url
        ? { pricing_url: t.cost.pricing_url || t.pricing_url }
        : {}),
      verified_on: REVIEWED,
      confidence: 'partially-verified',
    },
    implementation: {
      difficulty: t.difficulty,
      maintenance_burden: t.maintenance ?? 'medium',
      skills_required: t.skills ?? ['basic-linux', 'dns-tls'],
      typical_time_to_first_value: t.ttfv ?? '1–3 days',
      smallest_useful_experiment: t.experiment,
    },
    homepage: t.homepage,
    ...(t.repository ? { repository: t.repository } : {}),
    ...(t.documentation ? { documentation: t.documentation } : {}),
    links: [
      { label: 'Homepage', url: t.homepage, kind: 'homepage' },
      ...(t.repository ? [{ label: 'Source repository', url: t.repository, kind: 'repo' }] : []),
      ...(t.documentation ? [{ label: 'Documentation', url: t.documentation, kind: 'docs' }] : []),
      ...(t.cost.pricing_url || t.pricing_url
        ? [
            {
              label: 'Pricing',
              url: t.cost.pricing_url || t.pricing_url!,
              kind: 'pricing',
            },
          ]
        : []),
    ],
    tasks_reduced_or_augmented: t.tasks,
    human_oversight_still_needed: t.oversight,
    data_privacy: {
      data_held: t.data,
      personal_data: t.personal ?? true,
      payment_data: t.payment ?? false,
      ...(t.privacy_notes ? { notes: t.privacy_notes } : {}),
    },
    risks: t.risks ?? {
      vendor_lock_in: 'Evaluate export formats and API completeness before deep customization.',
      security: 'Apply updates promptly; restrict admin access; enable TLS.',
      compliance: 'Operator remains responsible for privacy and local regulatory obligations.',
      licensing: t.license.notes ?? 'Confirm license fits commercial coworking use.',
      operational: 'Plan backups, monitoring, and a restore drill before production use.',
    },
    integrations: (t.integrations ?? []).map((i) => ({
      name: i.name,
      direction: 'bidirectional',
      method: i.method ?? 'api',
      notes: i.notes,
      verified: i.verified ?? false,
    })),
    related_tools: [],
    ...(t.compose ? { compose_pack: t.compose } : {}),
    guide_status: guide,
    guide_path: `guides/tools/${t.id}.md`,
    tags: t.tags ?? [],
    verification: {
      status: 'partially-verified',
      last_reviewed: REVIEWED,
      sources: [t.homepage, t.repository, t.documentation].filter(Boolean),
      notes:
        'Seed entry compiled from official project sites and repositories. Re-verify pricing, license text, and feature claims before production decisions. Star counts and free-tier numeric limits intentionally omitted unless verified at review time.',
      reviewer: 'seed-catalog',
    },
    featured: Boolean(t.featured),
    rank_score: t.rank ?? 55,
  };
}

