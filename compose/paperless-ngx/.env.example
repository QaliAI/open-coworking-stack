# Registry-verified release and dependency tags on 2026-07-18.
# Pin digests before production.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:2.20.15
POSTGRES_IMAGE=postgres:18.0-alpine
REDIS_IMAGE=redis:8.2.1-alpine

BIND_ADDRESS=127.0.0.1
PAPERLESS_PORT=8000
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng

# Replace every marker with an independently generated value before startup.
PAPERLESS_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
PAPERLESS_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
PAPERLESS_SECRET_KEY=REPLACE_WITH_RANDOM_APPLICATION_SECRET
PAPERLESS_ADMIN_USER=REPLACE_WITH_NON_DEFAULT_ADMIN_USERNAME
PAPERLESS_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
