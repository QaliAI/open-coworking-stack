# n8n's documented stable release and registry-verified dependency tag on 2026-07-18.
# Pin digests before production.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.29.8
POSTGRES_IMAGE=postgres:18.0-alpine

BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Replace every marker with an independently generated value before startup.
N8N_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY
