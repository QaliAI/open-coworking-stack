# Verified release tags for configuration testing only. Pin digests before production.
NEXTCLOUD_IMAGE=nextcloud:34.0.1-apache
POSTGRES_IMAGE=postgres:18.0-alpine
REDIS_IMAGE=redis:8.2.1-alpine

BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=8080
NEXTCLOUD_TRUSTED_DOMAINS=localhost
NEXTCLOUD_OVERWRITE_PROTOCOL=http

# Replace every marker with an independently generated value before startup.
NEXTCLOUD_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
NEXTCLOUD_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
NEXTCLOUD_ADMIN_USER=REPLACE_WITH_NON_DEFAULT_ADMIN_USERNAME
NEXTCLOUD_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
