# Registry-verified release tag on 2026-07-18. Pin a digest before production.
VAULTWARDEN_IMAGE=vaultwarden/server:1.36.0

BIND_ADDRESS=127.0.0.1
VAULTWARDEN_PORT=8082
VAULTWARDEN_DOMAIN=http://localhost:8082
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

# Generate an Argon2 PHC string with Vaultwarden's documented hash command.
# Keep the value single-quoted because PHC strings contain dollar signs.
VAULTWARDEN_ADMIN_TOKEN='REPLACE_WITH_ARGON2_PHC_STRING'
