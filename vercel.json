  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/guides/integration-recipes",
      "destination": "/integrations/generated/",
      "permanent": true
    },
    {
      "source": "/guides/integration-recipes/",
      "destination": "/integrations/generated/",
      "permanent": true
    }
  ]
}
