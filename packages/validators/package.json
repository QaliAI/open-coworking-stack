{
  "name": "@ocs/validators",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ocs-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "freshness": "tsx src/cli.ts freshness",
    "lint": "echo \"no lint config in validators package\""
  },
  "dependencies": {
    "@ocs/schema": "workspace:*",
    "@ocs/shared": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
