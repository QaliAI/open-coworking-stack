---
import { readFile } from 'node:fs/promises';
import {
  licenseBadgeClass,
  categoryShortcuts,
  parseCatalogExport,
  readableLabel,
  withBasePath,
  type CatalogExport,
  type CatalogTool,
} from '../utils/catalog';

const dataUrl = new URL('../../public/data/catalog.json', import.meta.url);
let catalog: CatalogExport;

try {
  const source = await readFile(dataUrl, 'utf8');
  catalog = parseCatalogExport(JSON.parse(source));
} catch (cause) {
  const detail = cause instanceof Error ? cause.message : String(cause);
  throw new Error(
    `[DirectoryApp] Generated catalog data is missing or invalid (${detail}). Run pnpm generate before building the web app.`,
    { cause },
  );
}

const tools = catalog.tools;
const values = (getValues: (tool: CatalogTool) => string[]) =>
  [...new Set(tools.flatMap(getValues).filter(Boolean))].sort();
const categories = values((tool) => tool.categories);
const licenses = values((tool) => [tool.license_class]);
const roles = values((tool) => [
  ...tool.roles,
  ...(tool.task_fits ?? []).map((fit) => fit.role_assisted),
]);
const problems = values((tool) => tool.problems);
const workflows = values((tool) => tool.workflows);
const deployments = values((tool) => tool.deployment);
const costs = values((tool) => [tool.cost_model]);
const verificationStatuses = values((tool) => [tool.verification_status]);
const tiers = values((tool) => [tool.verification_tier ?? '']);
const completenessStatuses = values((tool) => [tool.verification_completeness ?? '']);
const confidenceStatuses = values((tool) => [tool.verification_confidence ?? '']);
const difficulties = values((tool) => [tool.difficulty]);
const guideStatuses = values((tool) => [tool.guide_status]);
const payload = JSON.stringify(tools).replaceAll('<', '\\u003c');
const base = import.meta.env.BASE_URL;

const tierOrder: Record<string, number> = {
  'verified-core': 0,
  evaluated: 1,
  'commercial-benchmark': 2,
  'research-backlog': 3,
  'historical-archived': 4,
  'avoid-new-deployment': 5,
};
const sortedTools = tools.slice().sort(
  (a, b) =>
    (tierOrder[a.verification_tier ?? ''] ?? 6) -
      (tierOrder[b.verification_tier ?? ''] ?? 6) ||
    b.rank_score - a.rank_score ||
    a.name.localeCompare(b.name),
);
const verifiedCoreCount = tools.filter(
  (tool) => tool.verification_tier === 'verified-core',
).length;
const evaluatedCount = tools.filter((tool) => tool.verification_tier === 'evaluated').length;
const taskFitCount = tools.filter((tool) => (tool.task_fits?.length ?? 0) > 0).length;
const fullGuideCount = tools.filter((tool) => tool.guide_status === 'full').length;

const statusText = (value: string | undefined, missing: string) =>
  value ? readableLabel(value) : missing;
const guideText = (status: string) => {
  if (status === 'full') return 'Full guide published';
  if (status === 'stub') return 'Guide stub only';
  if (status === 'planned') return 'Planned, not published';
  return readableLabel(status);
};
const guideHref = (tool: CatalogTool) =>
  tool.guide_status === 'full' || tool.guide_status === 'stub'
    ? withBasePath(`guides/tools/${tool.id}/`, base)
    : null;
---

<div class="ocs-directory" data-ocs-directory>
  <div class="ocs-category-shortcuts" aria-label="Browse by category">
    {categoryShortcuts.map((item) => <button type="button" data-collection={item.id} aria-pressed="false">{item.label}</button>)}
  </div>
  <nav class="ocs-tier-shortcuts" aria-label="Review groups">
    <button type="button" data-tier-filter="" aria-pressed="true">All tools ({tools.length})</button>
    <button type="button" data-tier-filter="evaluated" aria-pressed="false">Reviewed ({evaluatedCount})</button>
    <button type="button" data-tier-filter="research-backlog" aria-pressed="false">Not yet reviewed ({tools.filter((tool) => tool.verification_tier === 'research-backlog').length})</button>
    <button type="button" data-tier-filter="commercial-benchmark" aria-pressed="false">Paid alternatives ({tools.filter((tool) => tool.verification_tier === 'commercial-benchmark').length})</button>
  </nav>
  <p class="ocs-muted">"Reviewed" tools have been checked in depth for coworking use. "Not yet reviewed" tools look promising, but confirm the details on the official site. Paid alternatives are listed so you can compare. Free to browse, no account needed.</p>

  <details class="ocs-review-notes">
    <summary>How we review tools</summary>
  <aside class="ocs-directory-status" aria-labelledby="directory-status-title">
    <div>
      <h2 id="directory-status-title">How many tools we have checked</h2>
      <p>
        Each listing shows its review status, how complete it is and whether a setup guide exists.
        A recent review date alone does not mean a listing is complete.
      </p>
    </div>
    <dl>
      <div><dt>Fully verified</dt><dd>{verifiedCoreCount}</dd></div>
      <div><dt>Reviewed</dt><dd>{evaluatedCount}</dd></div>
      <div><dt>Checked against coworking tasks</dt><dd>{taskFitCount}</dd></div>
      <div><dt>Full setup guides</dt><dd>{fullGuideCount}</dd></div>
    </dl>
  </aside>
  </details>

  <p class="ocs-count" aria-live="polite" aria-atomic="true">
    Showing <span data-count>{tools.length}</span> of {tools.length} tools
    <span class="ocs-count-date">Catalog generated {catalog.generated_at.slice(0, 10)}</span>
  </p>

  <div class="ocs-filters" role="search" aria-label="Filter tools">
    <label class="ocs-search-field">
      Search tools
      <input
        type="search"
        data-filter="q"
        placeholder="Search CRM, meeting rooms, e-signatures, mailroom, marketing..."
        autocomplete="off"
      />
    </label>
    <input type="hidden" data-filter="collection" value="" />
    <label>
      Category
      <select data-filter="category">
        <option value="">Any category</option>
        {categories.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>
    <label>
      License class
      <select data-filter="license">
        <option value="">Any license</option>
        {licenses.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>
    <label>
      Deployment
      <select data-filter="deployment">
        <option value="">Any deployment</option>
        {deployments.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>
    <label>
      Difficulty
      <select data-filter="difficulty">
        <option value="">Any difficulty</option>
        {difficulties.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>
    <label>
      Review status
      <select data-filter="tier">
        <option value="">Any status</option>
        {tiers.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>

    <label>
      Cost model
      <select data-filter="cost">
        <option value="">Any cost model</option>
        {costs.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>

    <details class="ocs-advanced-filters">
      <summary>Advanced filters</summary>
      <div class="ocs-advanced-grid">
    <label>
      Role assisted
      <select data-filter="role">
        <option value="">Any role</option>
        {roles.map((value) => <option value={value}>{readableLabel(value)}</option>)}
      </select>
    </label>
        <label>
          Problem
          <select data-filter="problem">
            <option value="">Any problem</option>
            {problems.map((value) => <option value={value}>{readableLabel(value)}</option>)}
          </select>
        </label>
        <label>
          Workflow
          <select data-filter="workflow">
            <option value="">Any workflow</option>
            {workflows.map((value) => <option value={value}>{readableLabel(value)}</option>)}
          </select>
        </label>
        <label>
          Record status
          <select data-filter="verification">
            <option value="">Any status</option>
            {verificationStatuses.map((value) => (
              <option value={value}>{readableLabel(value)}</option>
            ))}
          </select>
        </label>
        <label>
          Completeness
          <select data-filter="completeness">
            <option value="">Any completeness</option>
            {completenessStatuses.map((value) => (
              <option value={value}>{readableLabel(value)}</option>
            ))}
          </select>
        </label>
        <label>
          Confidence
          <select data-filter="confidence">
            <option value="">Any confidence</option>
            {confidenceStatuses.map((value) => (
              <option value={value}>{readableLabel(value)}</option>
            ))}
          </select>
        </label>
        <label>
          Guide status
          <select data-filter="guide">
            <option value="">Any guide status</option>
            {guideStatuses.map((value) => <option value={value}>{guideText(value)}</option>)}
          </select>
        </label>
      </div>
    </details>

    <div class="ocs-filter-actions">
      <button type="button" class="ocs-reset" data-reset>Reset filters</button>
    </div>
  </div>

  <p class="ocs-no-results" data-no-results hidden>
    No tools match these filters. Change a filter or reset all filters to see the full directory.
  </p>

  <div class="ocs-result-cards" data-cards aria-label="Filtered tool results">
    {
      sortedTools.map((tool) => {
        const fit = tool.task_fits?.[0];
        const guide = guideHref(tool);
        return (
          <article class="ocs-operator-card" data-tool-id={tool.id} data-result-id={tool.id}>
            <header>
              <div>
                <h2>
                  <a href={withBasePath(`tools/generated/${tool.id}/`, base)}>{tool.name}</a>
                </h2>
                <p>{tool.tagline}</p>
              </div>
              <span class="ocs-tier" data-tier={tool.verification_tier ?? 'not-exported'}>
                {statusText(tool.verification_tier, 'Review status not recorded')}
              </span>
            </header>

            <p class="ocs-use-case"><strong>How a coworking space uses it:</strong> {tool.coworking_use_cases?.[0] ?? tool.tagline}</p>
            <p class="ocs-muted">{tool.categories.map(readableLabel).join(' · ')}</p>
            <div class="ocs-card-actions">
              <a href={tool.homepage}>Official site<span class="sr-only"> for {tool.name}</span></a>
              {tool.repository && <a href={tool.repository}>Source code<span class="sr-only"> for {tool.name}</span></a>}
              {tool.guide_status === 'full' && guide && <a href={guide}>Setup guide<span class="sr-only"> for {tool.name}</span></a>}
              <a href={withBasePath(`tools/generated/${tool.id}/`, base)}>Full listing<span class="sr-only"> for {tool.name}</span></a>
            </div>
            <details class="ocs-fit-summary">
              <summary>Who it helps and what your team still does</summary>
              <h3>Who it helps</h3>
              <dl>
                <div>
                  <dt>Helps</dt>
                  <dd>{fit ? readableLabel(fit.role_assisted) : 'Not reviewed yet'}</dd>
                </div>
                <div>
                  <dt>Manual work it cuts down</dt>
                  <dd>{fit?.manual_process ?? 'Not reviewed yet'}</dd>
                </div>
                <div>
                  <dt>Still done by your team</dt>
                  <dd>{fit?.human_work ?? 'Not reviewed yet'}</dd>
                </div>
              </dl>
            </details>

            <dl class="ocs-tool-facts">
              <div>
                <dt>License</dt>
                <dd>
                  <span class={licenseBadgeClass(tool.license_class)}>
                    {readableLabel(tool.license_class)}
                  </span>
                  {tool.spdx ? ` ${tool.spdx}` : ''}
                </dd>
              </div>
              <div><dt>Cost</dt><dd>{readableLabel(tool.cost_model)}</dd></div>
              <div>
                <dt>Deployment</dt>
                <dd>{tool.deployment.map(readableLabel).join(', ')}</dd>
              </div>
              <div>
                <dt>Skill</dt>
                <dd>
                  {tool.skills_required?.length
                    ? tool.skills_required.map(readableLabel).join(', ')
                    : 'Not included in this export'}
                </dd>
              </div>
              <div>
                <dt>Maintenance</dt>
                <dd>{statusText(tool.maintenance_burden, 'Not included in this export')}</dd>
              </div>
              <div><dt>Setup difficulty</dt><dd>{readableLabel(tool.difficulty)}</dd></div>
              <div>
                <dt>Listing completeness</dt>
                <dd>{statusText(tool.verification_completeness, 'Not included in export')}</dd>
              </div>
              <div>
                <dt>Our confidence</dt>
                <dd>{statusText(tool.verification_confidence, 'Not included in export')}</dd>
              </div>
              <div>
                <dt>Guide</dt>
                <dd>
                  {guide ? <a href={guide}>{guideText(tool.guide_status)}</a> : guideText(tool.guide_status)}
                </dd>
              </div>
            </dl>
          </article>
        );
      })
    }
  </div>

  <details class="ocs-table-view">
    <summary>Compact comparison table</summary>
  <div
    class="ocs-table-wrap"
    role="region"
    aria-label="Filtered tool results table"
    tabindex="0"
  >
    <table class="ocs-table">
      <caption>Operator comparison view. The mobile view presents the same records as cards.</caption>
      <thead>
        <tr>
          <th scope="col">Tool and purpose</th>
          <th scope="col">Operator task</th>
          <th scope="col">Cost and deployment</th>
          <th scope="col">Review status</th>
          <th scope="col">Pilot and guide</th>
        </tr>
      </thead>
      <tbody data-rows>
        {
          sortedTools.map((tool) => {
            const fit = tool.task_fits?.[0];
            const guide = guideHref(tool);
            return (
              <tr data-tool-id={tool.id} data-result-id={tool.id}>
                <td>
                  <a href={withBasePath(`tools/generated/${tool.id}/`, base)}>
                    <strong>{tool.name}</strong>
                  </a>
                  <div class="ocs-muted">{tool.tagline}</div>
                  <span class={licenseBadgeClass(tool.license_class)}>
                    {readableLabel(tool.license_class)}
                  </span>
                </td>
                <td>
                  <strong>{fit ? readableLabel(fit.role_assisted) : 'Not reviewed yet'}</strong>
                  <div class="ocs-muted">
                    {fit?.manual_process ?? 'Not reviewed yet'}
                  </div>
                  <div class="ocs-human-work">
                    Human: {fit?.human_work ?? 'Responsibilities not task-fit reviewed'}
                  </div>
                </td>
                <td>
                  {readableLabel(tool.cost_model)}
                  <div class="ocs-muted">{tool.deployment.map(readableLabel).join(', ')}</div>
                </td>
                <td>
                  <span class="ocs-tier" data-tier={tool.verification_tier ?? 'not-exported'}>
                    {statusText(tool.verification_tier, 'Not recorded')}
                  </span>
                  <div class="ocs-muted">
                    Completeness: {statusText(tool.verification_completeness, 'not exported')}
                  </div>
                  <div class="ocs-muted">
                    Confidence: {statusText(tool.verification_confidence, 'not exported')}
                  </div>
                </td>
                <td>
                  {readableLabel(tool.difficulty)}
                  <div>
                    {guide ? <a href={guide}>{guideText(tool.guide_status)}</a> : guideText(tool.guide_status)}
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  </details>
  <script type="application/json" data-tools set:html={payload} is:inline></script>
</div>

<script>
  import {
    directoryFilterKeys,
    emptyDirectoryFilters,
    matchesDirectoryTool,
    parseDirectoryFilters,
    serializeDirectoryFilters,
    type CatalogTool,
    type DirectoryFilters,
  } from '../utils/catalog';

  const root = document.querySelector<HTMLElement>('[data-ocs-directory]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = 'true';
    const payloadElement = root.querySelector<HTMLElement>('[data-tools]');
    const tools = JSON.parse(payloadElement?.textContent ?? '[]') as CatalogTool[];
    const results = new Map<string, HTMLElement[]>();
    for (const element of root.querySelectorAll<HTMLElement>('[data-result-id]')) {
      const id = element.dataset.resultId;
      if (!id) continue;
      results.set(id, [...(results.get(id) ?? []), element]);
    }
    const controls = Object.fromEntries(
      directoryFilterKeys.map((key) => [
        key,
        root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-filter="${key}"]`),
      ]),
    ) as Record<string, HTMLInputElement | HTMLSelectElement | null>;
    const count = root.querySelector<HTMLElement>('[data-count]');
    const noResults = root.querySelector<HTMLElement>('[data-no-results]');
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]');
    const advanced = root.querySelector<HTMLDetailsElement>('.ocs-advanced-filters');

    function readControls(): DirectoryFilters {
      const filters = emptyDirectoryFilters();
      for (const key of directoryFilterKeys) filters[key] = controls[key]?.value ?? '';
      return filters;
    }

    function writeControls(filters: DirectoryFilters) {
      for (const key of directoryFilterKeys) {
        const control = controls[key];
        if (!control) continue;
        const hasValue =
          control instanceof HTMLInputElement ||
          Array.from((control as HTMLSelectElement).options).some(
            (option) => option.value === filters[key],
          );
        control.value = hasValue ? filters[key] : '';
      }
    }

    function applyFilters(updateUrl: boolean | 'replace' = true) {
      const filters = readControls();
      root?.querySelectorAll<HTMLButtonElement>('[data-collection]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.collection === filters.collection));
      });
      root?.querySelectorAll<HTMLButtonElement>('[data-tier-filter]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.tierFilter === filters.tier));
      });
      let visible = 0;
      for (const tool of tools) {
        const show = matchesDirectoryTool(tool, filters);
        for (const result of results.get(tool.id) ?? []) result.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (noResults) noResults.hidden = visible !== 0;
      if (updateUrl) {
        const query = serializeDirectoryFilters(filters);
        const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
        if (nextUrl !== `${window.location.pathname}${window.location.search}${window.location.hash}`) {
          if (updateUrl === 'replace') window.history.replaceState(window.history.state, '', nextUrl);
          else window.history.pushState(window.history.state, '', nextUrl);
        }
      }
    }

    const initialFilters = parseDirectoryFilters(window.location.search);
    writeControls(initialFilters);
    if (
      advanced &&
      ['role', 'problem', 'workflow', 'cost', 'verification', 'completeness', 'confidence', 'guide'].some((key) => initialFilters[key as keyof DirectoryFilters])
    ) {
      advanced.open = true;
    }
    applyFilters(false);

    root.querySelectorAll<HTMLButtonElement>('[data-collection]').forEach((button) => {
      button.addEventListener('click', () => {
        if (controls.collection) controls.collection.value = controls.collection.value === button.dataset.collection ? '' : button.dataset.collection ?? '';
        if (controls.category) controls.category.value = '';
        applyFilters();
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-tier-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        if (controls.tier) controls.tier.value = button.dataset.tierFilter ?? '';
        applyFilters();
      });
    });
    window.addEventListener('popstate', () => {
      writeControls(parseDirectoryFilters(window.location.search));
      applyFilters(false);
    });

    let editingQuery = false;
    controls.q?.addEventListener('blur', () => { editingQuery = false; });
    for (const key of directoryFilterKeys) {
      const control = controls[key];
      control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', () => {
        applyFilters(key === 'q' && editingQuery ? 'replace' : true);
        editingQuery = key === 'q';
      });
    }
    reset?.addEventListener('click', () => {
      writeControls(emptyDirectoryFilters());
      applyFilters();
      controls.q?.focus();
    });
  }
</script>
