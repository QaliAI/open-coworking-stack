---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
---
<script is:inline>
  // A new visitor starts with the gateway's light palette. Saved dark or automatic choices win.
  try {
    if (localStorage.getItem('starlight-theme') === null) localStorage.setItem('starlight-theme', 'light');
  } catch { /* Starlight retains system-theme support when storage is unavailable. */ }
</script>
<ThemeProvider />
