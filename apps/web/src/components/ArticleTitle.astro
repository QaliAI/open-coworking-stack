---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
import catalog from '../../public/data/catalog.json';
import { categoryShortcuts, withBasePath, type CatalogTool } from '../utils/catalog';
const base = import.meta.env.BASE_URL;
const href = (p: string) => withBasePath(p, base);
const pathname = Astro.url.pathname;
const toolId = pathname.match(/\/(?:tools\/generated|guides\/tools)\/([^/]+)\//)?.[1];
const tool = catalog.tools.find((t) => t.id === toolId) as CatalogTool | undefined;
const family = ['tasks', 'roles', 'workflows', 'stacks', 'comparisons', 'guides'].find((f) => pathname.includes(`/${f}/`));
const recipes = pathname.includes('/integrations/');
const collections = tool ? categoryShortcuts.filter((c) => c.categories.some((cat) => tool.categories.includes(cat)) || c.tags?.some((tag) => (tool.tags ?? []).includes(tag))).slice(0, 2) : [];
const workflows = tool ? catalog.workflows.filter((w) => tool.workflows.includes(w.id)).slice(0, 3) : [];
---
<nav class="ocs-article-context" aria-label="Resource navigation">
  <a href={href('directory/')}>Back to all tools</a>
  <a href={href('library/')}>Resource library</a>
  {family && <a href={href(`${family}/`)}>All {family}</a>}
  {recipes && <a href={href('integrations/generated/')}>All integration recipes</a>}
</nav>
<PageTitle />
{tool && <nav class="ocs-related-context" aria-label="Related resources">
  {collections.map((c) => <a href={href(`directory/?collection=${c.id}`)}>Explore {c.label}</a>)}
  {tool.guide_status === 'full' && !pathname.includes('/guides/tools/') && <a href={href(`guides/tools/${tool.id}/`)}>Related guide: {tool.name}</a>}
  {workflows.map((w) => <a href={href(`workflows/generated/${w.id}/`)}>Workflow: {w.name}</a>)}
</nav>}
