---
import Footer from '@astrojs/starlight/components/Footer.astro';
import { withBasePath } from '../utils/catalog';
const base = import.meta.env.BASE_URL;
---
<nav class="ocs-brand-footer" aria-label="Explore the directory">
  <strong>CoworkingSpace.ai · Open Coworking Stack</strong>
  <a href={withBasePath('directory/', base)}>Browse all tools</a>
  <a href={withBasePath('library/', base)}>Explore every resource library</a>
  <a href="https://www.coworkingspace.ai/tools">Free Tools at CoworkingSpace.ai</a>
  <a href={withBasePath('contribute/', base)}>Suggest a correction</a>
</nav>
<Footer />
