---
import {
  calculateWorkflowCapacity,
  emptyWorkflowInput,
  formatCurrency,
  type WorkflowInput,
} from '../utils/roi-calculator';

const empty = calculateWorkflowCapacity(emptyWorkflowInput());
const currencyOptions = ['USD', 'EUR', 'GBP', 'CAD', 'AUD'];
---

<div class="estimator" data-estimator>
  <div class="layout">
    <form data-estimator-form>
      <fieldset>
        <legend>Currency</legend>
        <label>
          Currency for estimates
          <select name="currency" data-currency>
            {currencyOptions.map((c) => <option value={c} selected={c === 'USD'}>{c}</option>)}
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Workflow volume and time</legend>
        <p class="hint">Enter measured values where possible. <strong>Unchecked fields use assumed values only.</strong></p>
        <label>
          <span>Tasks per month <input name="tasksPerMonth" type="number" min="0" step="1" value="0" /></span>
          <small class="measured"><input name="measuredTasks" type="checkbox" /> Measured, not assumed</small>
        </label>
        <label>
          <span>Minutes per task today <input name="minutesPerTaskToday" type="number" min="0" step="0.1" value="0" /></span>
          <small class="measured"><input name="measuredTime" type="checkbox" /> Measured, not assumed</small>
        </label>
        <label>
          <span>Minutes per task with tool <input name="minutesPerTaskWithTool" type="number" min="0" step="0.1" value="0" /></span>
        </label>
        <label>
          <span>Expected adoption <span><input name="adoptionPercent" type="range" min="0" max="100" step="5" value="0" data-adoption /> <output data-adoption-output>0%</output></span></span>
        </label>
      </fieldset>

      <fieldset>
        <legend>Cost rates</legend>
        <label>
          <span>Loaded hourly labor cost <input name="loadedHourlyLaborCost" type="number" min="0" step="0.01" value="0" /></span>
          <small class="measured"><input name="measuredLaborCost" type="checkbox" /> Measured, not assumed</small>
        </label>
        <label>
          One-time implementation cash cost <input name="oneTimeSetupCost" type="number" min="0" step="0.01" value="0" />
        </label>
        <label>
          Monthly software and hosting cash cost <input name="monthlySoftwareHostingCost" type="number" min="0" step="0.01" value="0" />
        </label>
        <label>
          Other monthly cash cost <input name="monthlyOtherCashCost" type="number" min="0" step="0.01" value="0" />
        </label>
        <label>
          Annual price increase on cash costs <span><input name="annualPriceIncreasePercent" type="number" min="0" step="1" value="0" /> %</span>
        </label>
      </fieldset>

      <fieldset>
        <legend>Labor, training, and overhead</legend>
        <label>
          Monthly maintenance hours <input name="monthlyMaintenanceHours" type="number" min="0" step="0.1" value="0" />
        </label>
        <label>
          Downtime and incident hours per month <input name="downtimeHoursPerMonth" type="number" min="0" step="0.1" value="0" />
        </label>
        <label>
          Training hours per user <input name="trainingHoursPerUser" type="number" min="0" step="0.5" value="0" />
        </label>
        <label>
          Users to train <input name="usersToTrain" type="number" min="0" step="1" value="0" />
        </label>
        <label>
          One-time migration hours <input name="oneTimeMigrationHours" type="number" min="0" step="1" value="0" />
        </label>
        <label>
          Adoption ramp before steady state (months) <input name="adoptionRampMonths" type="number" min="0" step="1" value="0" />
        </label>
      </fieldset>

      <fieldset>
        <legend>Risk and contingency</legend>
        <label>
          Exception handling overhead <span><input name="exceptionHandlingPercent" type="number" min="0" step="5" value="0" /> % of capacity value</span>
        </label>
        <label>
          Contingency on one-time costs <span><input name="contingencyPercent" type="number" min="0" step="5" value="0" /> %</span>
        </label>
      </fieldset>

      <fieldset>
        <legend>Cash savings mode</legend>
        <p class="hint">By default, the tool estimates capacity value — time that <em>may</em> become available. Check this box only if cash expense will actually decrease (staff reduction, no replacement hiring, or contract cancellation).</p>
        <label>
          <input name="actualCashSavings" type="checkbox" data-cash-savings />
          <span>This tooling will reduce cash expense</span>
        </label>
      </fieldset>

      <div class="form-actions">
        <button type="submit">Calculate</button>
        <button type="button" class="secondary" data-load-example>Load example (fabricated)</button>
        <button type="reset" class="secondary">Reset all</button>
      </div>
    </form>

    <section class="output" aria-labelledby="estimator-output-heading" aria-live="polite" data-output>
      <p class="eyebrow">Base case</p>
      <h2 id="estimator-output-heading">Workflow capacity and cost</h2>
      <div class="metrics">
        <div><span>Hours potentially redirected / month</span><strong data-base="hoursRedirected">0</strong></div>
        <div><span>Gross labor capacity value / month</span><strong data-base="grossCapacityValue">—</strong></div>
        <div><span>Monthly cash cost</span><strong data-base="monthlyCashCost">—</strong></div>
        <div><span>Monthly labor cost (maintenance + downtime)</span><strong data-base="monthlyLaborCost">—</strong></div>
        <div><span>Net monthly capacity value</span><strong data-base="netCapacityValue">—</strong></div>
        <div><span>First-year capacity estimate (net of one-time costs)</span><strong data-base="firstYearCapacityEstimate">—</strong></div>
        <div><span>Estimated payback period</span><strong data-base="paybackMonths">—</strong></div>
        <div><span>First-year return on investment</span><strong data-base="firstYearReturnPercent">—</strong></div>
      </div>

      <p class="cash-savings-note" data-cash-note hidden>
        <strong>Cash savings mode active.</strong> Ensure staff costs will actually decrease. This is not a prediction.
      </p>

      <h3>Sensitivity range</h3>
      <p class="hint">Low uses 80% of task volume and time difference; high uses 120% of each. Adoption stays at your entered assumption.</p>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Sensitivity results. Scroll horizontally to see every column.">
        <table>
          <thead><tr><th scope="col">Case</th><th scope="col">Hours redirected</th><th scope="col">Monthly net</th><th scope="col">First-year net</th><th scope="col">Payback</th></tr></thead>
          <tbody data-cases>
            {empty.cases.map((item) => <tr><th scope="row">{item.name}</th><td>{item.hoursRedirected}</td><td>—</td><td>—</td><td>—</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="disclaimer" aria-label="Estimator limitations">
    <strong>No savings promise.</strong> This directional model values time that may be redirected; it is not cash savings unless staffing or contract expense actually changes. Results depend on measured adoption, task time, workflow quality, implementation, maintenance, exceptions, and demand. All figures are estimates only — verify assumptions with a small pilot before making financial decisions. This is not financial, accounting, tax, employment, or procurement advice.
  </aside>
</div>

<script>
  import {
    calculateWorkflowCapacity,
    emptyWorkflowInput,
    exampleWorkflowInput,
    formatCurrency,
    type WorkflowInput,
  } from '../utils/roi-calculator';

  const root = document.querySelector<HTMLElement>('[data-estimator]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = 'true';
    const form = root.querySelector<HTMLFormElement>('[data-estimator-form]');
    const range = root.querySelector<HTMLInputElement>('[data-adoption]');
    const rangeOutput = root.querySelector<HTMLOutputElement>('[data-adoption-output]');
    const output = root.querySelector<HTMLElement>('[data-output]');
    const cashNote = root.querySelector<HTMLElement>('[data-cash-note]');
    const loadExample = root.querySelector<HTMLButtonElement>('[data-load-example]');

    function number(data: FormData, key: string): number {
      return Number(data.get(key) ?? 0);
    }

    function boolean(data: FormData, key: string): boolean {
      return data.get(key) === 'on';
    }

    function readInput(): WorkflowInput {
      if (!form) return emptyWorkflowInput();
      const data = new FormData(form);
      return {
        currency: String(data.get('currency') ?? 'USD') as WorkflowInput['currency'],
        tasksPerMonth: number(data, 'tasksPerMonth'),
        minutesPerTaskToday: number(data, 'minutesPerTaskToday'),
        minutesPerTaskWithTool: number(data, 'minutesPerTaskWithTool'),
        adoptionPercent: number(data, 'adoptionPercent'),
        loadedHourlyLaborCost: number(data, 'loadedHourlyLaborCost'),
        oneTimeSetupCost: number(data, 'oneTimeSetupCost'),
        monthlySoftwareHostingCost: number(data, 'monthlySoftwareHostingCost'),
        monthlyMaintenanceHours: number(data, 'monthlyMaintenanceHours'),
        monthlyOtherCashCost: number(data, 'monthlyOtherCashCost'),
        trainingHoursPerUser: number(data, 'trainingHoursPerUser'),
        usersToTrain: number(data, 'usersToTrain'),
        exceptionHandlingPercent: number(data, 'exceptionHandlingPercent'),
        downtimeHoursPerMonth: number(data, 'downtimeHoursPerMonth'),
        adoptionRampMonths: number(data, 'adoptionRampMonths'),
        oneTimeMigrationHours: number(data, 'oneTimeMigrationHours'),
        annualPriceIncreasePercent: number(data, 'annualPriceIncreasePercent'),
        contingencyPercent: number(data, 'contingencyPercent'),
        measuredTasks: boolean(data, 'measuredTasks'),
        measuredTime: boolean(data, 'measuredTime'),
        measuredLaborCost: boolean(data, 'measuredLaborCost'),
        actualCashSavings: boolean(data, 'actualCashSavings'),
      };
    }

    function setField(name: string, value: string | number | boolean) {
      const el = form?.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
      if (!el) return;
      if (el.type === 'checkbox') {
        (el as HTMLInputElement).checked = Boolean(value);
      } else {
        el.value = String(value);
      }
    }

    function loadExampleValues() {
      const example = exampleWorkflowInput();
      setField('currency', example.currency);
      setField('tasksPerMonth', example.tasksPerMonth);
      setField('minutesPerTaskToday', example.minutesPerTaskToday);
      setField('minutesPerTaskWithTool', example.minutesPerTaskWithTool);
      setField('adoptionPercent', example.adoptionPercent);
      setField('loadedHourlyLaborCost', example.loadedHourlyLaborCost);
      setField('oneTimeSetupCost', example.oneTimeSetupCost);
      setField('monthlySoftwareHostingCost', example.monthlySoftwareHostingCost);
      setField('monthlyMaintenanceHours', example.monthlyMaintenanceHours);
      setField('monthlyOtherCashCost', example.monthlyOtherCashCost);
      setField('trainingHoursPerUser', example.trainingHoursPerUser);
      setField('usersToTrain', example.usersToTrain);
      setField('exceptionHandlingPercent', example.exceptionHandlingPercent);
      setField('downtimeHoursPerMonth', example.downtimeHoursPerMonth);
      setField('adoptionRampMonths', example.adoptionRampMonths);
      setField('oneTimeMigrationHours', example.oneTimeMigrationHours);
      setField('annualPriceIncreasePercent', example.annualPriceIncreasePercent);
      setField('contingencyPercent', example.contingencyPercent);
      if (rangeOutput) rangeOutput.value = `${example.adoptionPercent}%`;
      render();
    }

    function render() {
      const input = readInput();
      const result = calculateWorkflowCapacity(input);
      const currency = input.currency;

      if (cashNote) {
        cashNote.hidden = !input.actualCashSavings;
      }

      const metrics = [
        ['hoursRedirected', String(result.base.hoursRedirected)],
        ['grossCapacityValue', result.base.grossCapacityValue > 0 ? formatCurrency(result.base.grossCapacityValue, currency) : '—'],
        ['monthlyCashCost', result.base.monthlyCashCost > 0 ? formatCurrency(result.base.monthlyCashCost, currency) : '—'],
        ['monthlyLaborCost', result.base.monthlyLaborCost > 0 ? formatCurrency(result.base.monthlyLaborCost, currency) : '—'],
        ['netCapacityValue', result.base.netCapacityValue !== 0 ? formatCurrency(result.base.netCapacityValue, currency) : '—'],
        ['firstYearCapacityEstimate', result.base.firstYearCapacityEstimate !== 0 ? formatCurrency(result.base.firstYearCapacityEstimate, currency) : '—'],
        ['paybackMonths', result.base.paybackMonths === null ? 'Not within model period' : `${result.base.paybackMonths} months`],
        ['firstYearReturnPercent', result.base.firstYearReturnPercent === null ? 'Not applicable' : `${result.base.firstYearReturnPercent}%`],
      ] as const;

      for (const [key, value] of metrics) {
        const el = root?.querySelector<HTMLElement>(`[data-base="${key}"]`);
        if (el) el.textContent = value;
      }

      const body = root?.querySelector<HTMLTableSectionElement>('[data-cases]');
      if (body) body.replaceChildren(...result.cases.map((item) => {
        const row = document.createElement('tr');
        const heading = document.createElement('th');
        heading.scope = 'row';
        heading.textContent = item.name;
        const cells = [
          String(item.hoursRedirected),
          item.netCapacityValue !== 0 ? formatCurrency(item.netCapacityValue, currency) : '—',
          item.firstYearCapacityEstimate !== 0 ? formatCurrency(item.firstYearCapacityEstimate, currency) : '—',
          item.paybackMonths === null ? 'Not within model period' : `${item.paybackMonths} months`,
        ].map((value) => {
          const cell = document.createElement('td');
          cell.textContent = value;
          return cell;
        });
        row.append(heading, ...cells);
        return row;
      }));
    }

    form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
    form?.addEventListener('input', render);
    loadExample?.addEventListener('click', loadExampleValues);
    range?.addEventListener('input', () => { if (rangeOutput) rangeOutput.value = `${range.value}%`; });
  }
</script>

<style>
  .estimator { --ink: #17251f; --line: #cad8d0; color: var(--ink); }
  .layout { display: grid; gap: 1.25rem; grid-template-columns: minmax(15rem, .7fr) minmax(0, 1.3fr); }
  form { align-self: start; background: #f6f9f7; border: 1px solid var(--line); padding: 1rem; }
  fieldset { border: 0; border-top: 2px solid #39745a; display: grid; gap: .75rem; margin: 0 0 1rem; padding: .8rem 0 0; }
  legend { font-weight: 800; padding-right: .5rem; }
  label { display: grid; font-size: .82rem; font-weight: 650; gap: .2rem; }
  label span { align-items: center; display: flex; gap: .5rem; }
  .measured { font-size: .75rem; font-weight: 400; }
  .measured input { margin: 0; }
  .hint { color: #50635a; font-size: .82rem; }
  input, select, button { font: inherit; }
  input[type="number"], select { border: 1px solid #82978c; border-radius: .2rem; min-width: 0; padding: .5rem; }
  input[type="range"] { flex: 1; }
  input:focus-visible, select:focus-visible, button:focus-visible, .table-wrap:focus-visible { outline: 3px solid #e9a23b; outline-offset: 2px; }
  button { background: #173f31; border: 0; border-radius: .2rem; color: white; cursor: pointer; font-weight: 750; padding: .65rem .85rem; }
  button.secondary { background: white; border: 1px solid #173f31; color: #173f31; }
  .form-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .output { min-width: 0; }
  .eyebrow { color: #39745a; font-size: .75rem; font-weight: 800; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .output h2 { margin-top: .15rem; }
  .metrics { display: grid; gap: .55rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .metrics div { background: #f6f9f7; border-left: 4px solid #39745a; display: grid; gap: .35rem; padding: .75rem; }
  .metrics span { color: #50635a; font-size: .75rem; }
  .metrics strong { font-size: 1.1rem; }
  .cash-savings-note { background: #fff7e6; border-left: 5px solid #b57416; font-size: .85rem; padding: .75rem; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; font-size: .82rem; min-width: 36rem; width: 100%; }
  th, td { border-bottom: 1px solid var(--line); padding: .55rem; text-align: left; }
  thead { background: #edf4ef; }
  .disclaimer { background: #fff7e6; border-left: 5px solid #b57416; font-size: .88rem; margin-top: 1.25rem; padding: 1rem; }
  @media (max-width: 44rem) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 320px) { form { padding: .7rem; } .metrics { grid-template-columns: 1fr; } }
</style>
